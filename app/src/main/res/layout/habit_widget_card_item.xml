<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <!-- Header containing Card Name -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Morning Ritual"
            android:textColor="#888888"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:textAllCaps="true" />
    </RelativeLayout>

    <!-- Main Content Area -->
    <TextView
        android:id="@+id/widget_primary_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Put on workout shoes"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center_vertical" />

    <!-- Bottom Actions Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/widget_secondary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Right Now habit"
            android:textColor="#888888"
            android:textSize="10sp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@+id/widget_complete_btn" />

        <!-- One-tap complete check circle -->
        <ImageView
            android:id="@+id/widget_complete_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/checkbox_off_background"
            android:contentDescription="Toggle Complete"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:padding="2dp"
            android:clickable="true"
            android:focusable="true"/>
    </RelativeLayout>
</LinearLayout>
